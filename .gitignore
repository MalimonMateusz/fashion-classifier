###########################
# Dane i modele
#
# Zdjecia, cechy i wagi sa duze (ONNX ~345 MB) i odtwarzalne:
# scripts/scrape_erli.py + `kedro run`. Gotowy model -> GitHub Releases.

data/**
!data/**/
!data/**/.gitkeep

# ...poza malymi artefaktami, ktore dokumentuja wyniki
!data/06_models/model_card.json
!data/08_reporting/*.json
!data/08_reporting/*.csv
!data/08_reporting/metrics/*.json

# wagi modeli poza data/ (np. eksport recznie albo z notebooka)
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.pkl
*.pickle

##########################
# Kedro

# lokalna konfiguracja i sekrety
conf/local/**
!conf/local/.gitkeep
conf/**/*credentials*
.telemetry

# kedro-viz
.viz/

# logi
*.log
logs/

##########################
# Python

__pycache__/
*.py[cod]
*$py.class
*.so

# pakowanie
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg

# srodowiska
.venv/
venv/
env/
.env
.envrc
.python-version

# testy, lint, typy
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/

# cache bibliotek (HF / torch / open_clip, jesli ustawione lokalnie)
.cache/

##########################
# Notebooki

.ipynb_checkpoints/
.ipython/

